FIREBASE_PROJECT_ID=carrollpingpongclub
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_DOCUMENT_PATH=clubs/carroll-pingpong
# Credentials belong in Render/Vercel environment settings, never GitHub or frontend code.

# Admin credentials are configured only on the server. There is no public signup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional: exact public URL if the proxy does not pass the correct host.
# APP_ORIGIN=https://carrollpingpong.onrender.com
